// OpenSUSE 16.1 with EFI Boot

{
  // ====== ISO settings ====================================================
  "iso_url": "https://download.opensuse.org/tumbleweed/appliances/iso/agama-installer.x86_64-22.0.0-openSUSE-Snapshot20260623.iso",
  "iso_checksum": "file:https://download.opensuse.org/tumbleweed/appliances/iso/agama-installer.x86_64-22.0.0-openSUSE-Snapshot20260623.iso.sha256",
  "ssh_username": "{{user `user_name`}}",
  "ssh_password": "{{user `user_password`}}",
  "ssh_pty": true,
  "ssh_timeout": "60m",
  "ssh_handshake_attempts": "1024",
  "shutdown_command": "echo '{{user `user_password`}}' | sudo -S shutdown -P now",

  // ====== Boot into installer =============================================
  "boot_wait": "10s",
  "boot_command": [
    "e",
    "<down><down><down><down><end>",
    " netsetup=dhcp inst.auto=http://{{ .HTTPIP }}:{{ .HTTPPort }}/autoinst.json",
    "<wait><wait><wait><wait><wait><f10>"
  ]
}
