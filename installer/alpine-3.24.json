// Alpine 3.24 with EFI Boot

{
  // ====== ISO settings ====================================================
  "iso_url": "https://dl-cdn.alpinelinux.org/alpine/v3.24/releases/x86_64/alpine-standard-3.24.1-x86_64.iso",
  "iso_checksum": "sha512:fd80cc7aeb60e40af60a683790e89385b8a506d7430ea972793f8d0f318d4bc95276ee38923fa784ee9413eb47dd297006b808a5935ac6ec00eadf1e12095e71",
  "ssh_username": "{{user `user_name`}}",
  "ssh_password": "{{user `user_password`}}",
  "ssh_pty": true,
  "ssh_timeout": "60m",
  "ssh_handshake_attempts": "1024",
  "shutdown_command": "echo '{{user `user_password`}}' | doas poweroff",

  // ====== Boot into installer =============================================
  "boot_wait": "30s",
  "boot_command": [
    "root<enter>",
    "ifconfig eth0 up && udhcpc -i eth0<enter><wait5s>",
    "wget -qO install.sh http://{{.HTTPIP}}:{{.HTTPPort}}/install.sh && ",
    "chmod +x install.sh && ",
    "./install.sh<enter>"
  ]
}
