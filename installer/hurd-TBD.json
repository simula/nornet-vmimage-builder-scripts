// GNU Hurd

// **** TBD, this does not work, yet ... ****

{
  // ====== ISO settings ====================================================
  "iso_url": "https://cdimage.debian.org/cdimage/ports/latest/hurd-amd64/20260314/debian-sid-hurd-amd64-NETINST-1.iso",
  "iso_checksum": "file:https://cdimage.debian.org/cdimage/ports/latest/hurd-amd64/20260314/MD5SUMS",
  "ssh_username": "{{user `user_name`}}",
  "ssh_password": "{{user `user_password`}}",
  "ssh_pty": true,
  "ssh_timeout": "60m",
  "ssh_handshake_attempts": "1024",
  "shutdown_command": "echo '{{user `user_password`}}' | sudo -S shutdown -P now",

  // ====== Boot into installer =============================================
  "vboxmanage": [
    [ "modifyvm", "{{.Name}}", "--hpet",     "on"       ],
    [ "modifyvm", "{{.Name}}", "--nictype1", "82545EM"  ],
    [ "modifyvm", "{{.Name}}", "--ostype",   "Other_64" ]
  ],
  "boot_wait": "10s",
  "boot_command": [
    "e<down><down><down><end>priority=critical",
    " fb=false",
    " auto=true",
    " debconf/frontend=noninteractive",
    " console-setup/ask_detect=false",
    " debian-installer=en_US",
    " kbd-chooser/method=us",
    " keyboard-configuration/layout=USA",
    " keyboard-configuration/variant=USA",
    " locale=en_US",
    " netcfg/get_domain={{user `host_domain`}}",
    " netcfg/get_hostname={{user `host_name`}}",
    " preseed/url=http://{{ .HTTPIP }}:{{ .HTTPPort }}/debian.preseed",
    "<wait><leftCtrlOn>x<leftCtrlOff>"
   ]
}
