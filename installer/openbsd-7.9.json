// OpenBSD 7.9

{
  // ====== ISO settings ====================================================
  // Checksum: curl -s https://cdn.openbsd.org/pub/OpenBSD/7.9/amd64/SHA256 | grep -- .iso
  "iso_url": "https://ftp.eu.openbsd.org/pub/OpenBSD/7.9/amd64/install79.iso",
  "iso_checksum": "file:https://ftp.eu.openbsd.org/pub/OpenBSD/7.9/amd64/SHA256",
  "ssh_username": "{{user `user_name`}}",
  "ssh_password": "{{user `user_password`}}",
  "ssh_pty": true,
  "ssh_timeout": "60m",
  "ssh_handshake_attempts": "1024",
  "shutdown_command": "echo '{{user `user_password`}}' | sudo -S shutdown -p now",

  // ====== Boot into installer =============================================
  "vboxmanage": [
    // [ "modifyvm", "{{.Name}}", "--graphicscontroller", "vmsvga"     ],
    [ "modifyvm", "{{.Name}}", "--vram",               "4"          ],
    // [ "modifyvm", "{{.Name}}", "--nictype1",           "82545EM"    ],
    [ "modifyvm", "{{.Name}}", "--mouse",              "usbtablet"  ],
    [ "modifyvm", "{{.Name}}", "--ostype",             "OpenBSD_64" ]
  ],
  "boot_wait": "30s",
  "boot_command": [
    "S<enter><wait>",
    // "ifconfig em0 inet autoconf<enter>",
    // "ifconfig em0 inet6 autoconf<enter>",
    "NIC=$(ifconfig | sed -n -e '/^[a-z]/!d' -e '/^lo/d' -e '/^enc/d' -e '/^pflog/d' -e 's/:.*//p' | sed 1q)<enter>",
    "ifconfig $NIC inet autoconf<enter>",
    "ifconfig $NIC inet6 autoconf<enter>",
    "<wait><wait><wait>",
    "mkdir -p /tmp/autoinstall && ",
    "ftp -o /tmp/autoinstall/install.conf http://{{ .HTTPIP }}:{{ .HTTPPort }}/install.conf && ",
    "ftp -o /tmp/autoinstall/disk-layout.template http://{{ .HTTPIP }}:{{ .HTTPPort }}/disk-layout.template && ",
    "VDOT=$(sysctl -n kern.osrelease) && V=$(echo $VDOT | sed 's/\\.//g') && ",
    "ftp -o \"/tmp/autoinstall/site$V.tgz\" http://{{ .HTTPIP }}:{{ .HTTPPort }}/site.tgz && ",
    "sed -i\"\" \"s/<VERSION_DOT>/$VDOT/g; s/<VERSION>/$V/g; s/<NIC>/$NIC/g\" /tmp/autoinstall/install.conf && ",
    "ping -c3 -i0.3 www.heise.de && ",
    "install -a -f /tmp/autoinstall/install.conf && ",
    "reboot<enter>"
  ]
}
