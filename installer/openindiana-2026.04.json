// OpenIndiana Hipster 2026.04

{
  // ====== ISO settings ====================================================
  "iso_url": "https://dlc.openindiana.org/isos/hipster/20260430/OI-hipster-text-20260430.iso",
  "iso_checksum": "file:https://dlc.openindiana.org/isos/hipster/20260430/OI-hipster-text-20260430.iso.sha256sum",
  "ssh_username": "{{user `user_name`}}",
  "ssh_password": "{{user `user_password`}}",
  "ssh_pty": true,
  "ssh_timeout": "60m",
  "ssh_handshake_attempts": "1024",
  "shutdown_command": "echo '{{user `user_password`}}' | sudo -S shutdown -p now",

  // ====== Boot into installer =============================================
  "vboxmanage": [
    // [ "modifyvm", "{{.Name}}", "--graphicscontroller", "vboxsvga"       ],
    [ "modifyvm", "{{.Name}}", "--nictype1",           "82545EM"        ],
    [ "modifyvm", "{{.Name}}", "--mouse",              "usbtablet"      ],
    [ "modifyvm", "{{.Name}}", "--ostype",             "OpenSolaris_64" ]
  ],
  "boot_wait": "45s",
  "boot_command": [
    // Set language and keyboard layout to default (US English):
    "<enter><wait10s>",
    "<enter><wait30s>",
    "1<enter><wait10s>",
    // Prepare storage:
    "<f2><wait10s>",
    "<f2><wait10s>",
    "<right><enter><wait10s>",
    "<f2><wait10s>",
    // Set hostname and automatic network configuration:
    "<bs><bs><bs><bs><bs><bs><bs><bs><bs><bs><bs>{{user `host_name`}}.{{user `host_domain`}}<down><f2><wait5s>",
    // Select time zone and date/time:
    "<f2><wait5s><f2>",
    // User settings:
    "{{user `user_password`}}<down>",
    "{{user `user_password`}}<down>",
    "{{user `user_realname`}}<down>",
    "{{user `user_name`}}<down>",
    "{{user `user_password`}}<down>",
    "{{user `user_password`}}<down>",
    "<f2><wait5s>",
    // Confirm:
    "<f2>",
    "<wait300s><wait300s>",
    // Shell after installation:
    "<f9>3<enter>"
  ]
}
