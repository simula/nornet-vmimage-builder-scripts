// NetBSD 11.0

{
  // ====== ISO settings ====================================================
  // Checksum: curl -s https://cdn.netbsd.org/pub/NetBSD/images/11.0_RC4/SHA512 | grep -- -amd64.iso
  "iso_url": "https://cdn.netbsd.org/pub/NetBSD/images/11.0_RC4/NetBSD-11.0_RC4-amd64.iso",
  "iso_checksum": "file:https://cdn.netbsd.org/pub/NetBSD/images/11.0_RC4/SHA512",
  "ssh_username": "{{user `user_name`}}",
  "ssh_password": "{{user `user_password`}}",
  "ssh_pty": true,
  "ssh_timeout": "60m",
  "ssh_handshake_attempts": "1024",
  "shutdown_command": "echo '{{user `user_password`}}' | sudo -S shutdown -p now",

  // ====== Boot into installer =============================================
  "vboxmanage": [
    [ "modifyvm", "{{.Name}}", "--nictype1", "82545EM" ],
    [ "modifyvm", "{{.Name}}", "--ostype", "NetBSD_64" ]
  ],
  "boot_wait": "45s",
  "boot_command": [
    "<enter><enter>e<enter><enter>dhcpcd wm0<enter>sleep 2<enter>",
    "cd /tmp && ",
    "ftp -o installer http://{{ .HTTPIP }}:{{ .HTTPPort }}/installer && ",
    "ping -c3 -i0.3 www.heise.de && ",
    "chmod +x installer && ",
    "./installer<enter>"
  ]
}
