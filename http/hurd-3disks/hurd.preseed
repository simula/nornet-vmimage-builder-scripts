# Debian GNU/Hurd Preseed Configuration

# ====== Auto-Install =======================================================
d-i auto-install/enable                 boolean true
debconf debconf/priority                select critical

# ====== Localization and Keyboard ==========================================
# Using Irish locale (€, metric units, etc.):
d-i debian-installer/country            string NO
d-i debian-installer/language           string en_IE:en
d-i debian-installer/locale             string en_IE.UTF-8

# These lines are necessary to fill variables, but are not actually applied!
# Need to set keyboard layout by late_command ...
d-i console-setup/ask_detect            boolean false
d-i keyboard-configuration/modelcode    string pc105
d-i keyboard-configuration/layoutcode   string de
d-i keyboard-configuration/xkb-keymap   select de
d-i keyboard-configuration/variantcode  string nodeadkeys
d-i keyboard-configuration/optionscode  string ""

# ====== Network ============================================================
d-i netcfg/choose_interface             select auto
d-i netcfg/disable_autoconfig           boolean false
d-i netcfg/disable_dhcp                 boolean false
d-i netcfg/confirm_static               boolean true

d-i netcfg/get_hostname                 string <SET_HOSTNAME_HERE>
d-i netcfg/get_domain                   string <SET_DOMAINNAME_HERE>

# ====== Time ===============================================================
d-i clock-setup/utc                     boolean true
d-i clock-setup/ntp                     boolean true
d-i clock-setup/ntp-server              string pool.ntp.org
d-i time/zone                           string UTC

# ====== User ===============================================================
d-i passwd/root-login                   boolean false
d-i passwd/make-user                    boolean true
d-i passwd/user-fullname                string  <SET_REALNAME_HERE>
d-i passwd/username                     string  <SET_USERNAME_HERE>
d-i passwd/user-password-crypted        password <SET_HASHED_PASSWORD_HERE>
# NOTE: Example to add crypted password: echo "my password" | mkpasswd -s -m sha-512
d-i passwd/user-uid                     string  1000
d-i passwd/user-default-groups          string  adm cdrom sudo dip plugdev
d-i user-setup/encrypt-home             boolean false

# ====== Disk (MBR + single ext2 root, no swap during install) ==============
d-i partman-basicfilesystems/no_swap    boolean false

d-i partman/confirm                     boolean true
d-i partman/confirm_write_new_label     boolean true
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/confirm_nooverwrite         boolean true
d-i partman/choose_partition            select finish

d-i partman-partitioning/choose_label   string msdos
d-i partman-partitioning/default_label  string msdos

# Note: On GNU/Hurd, disks are typically /dev/wd0..wd2 (rumpdisk) or /dev/hd0..hd2 (Mach IDE).
d-i partman-auto/disk                   string <SET_ROOT_DISK_DEVICE_HERE>
d-i partman-auto/method                 string regular
d-i partman-auto/choose_recipe          string root
d-i partman-auto/expert_recipe          string \
      root ::                                                     \
              4096 16384 -1 ext2                                  \
                      $primary{ } $bootable{ }                    \
                      method{ format } format{ }                  \
                      use_filesystem{ } filesystem{ ext2 }        \
                      mountpoint{ / }                             \
              .

# ====== Mirror (Debian Ports for hurd-amd64) ===============================
d-i mirror/country                                  string manual
d-i mirror/protocol                                 string http
d-i mirror/http/proxy                               string
d-i mirror/http/hostname                            string deb.debian.org
d-i mirror/http/directory                           string /debian-ports
d-i mirror/suite                                    string sid

# ====== Grub (BIOS/MBR) ====================================================
grub-pc grub-pc/install_devices                     string <SET_ROOT_DISK_DEVICE_HERE>
d-i grub-pc/install_devices_empty                   boolean yes
d-i grub-installer/bootdev                          string <SET_ROOT_DISK_DEVICE_HERE>
d-i grub-installer/only_debian                      boolean true
d-i grub-installer/with_other_os                    boolean true

# ====== Packages ===========================================================
# Repositories (debian-ports does not provide standard contrib/non-free/security):
popularity-contest popularity-contest/participate   boolean false
d-i apt-setup/cdrom/set-first                       boolean false
d-i apt-setup/contrib                               boolean false
d-i apt-setup/non-free                              boolean false
d-i apt-setup/non-free-firmware                     boolean false
d-i apt-setup/enable-source-repositories            boolean false
d-i apt-setup/services-select                       multiselect

# Package settings (avoid Linux-only acpid/qemu-guest-agent and sid full-upgrade):
tasksel tasksel/first                               multiselect standard, ssh-server
d-i pkgsel/language-packs                           multiselect en
d-i pkgsel/install-language-support                 boolean false
d-i pkgsel/update-policy                            select none
d-i pkgsel/upgrade                                  select safe-upgrade
d-i pkgsel/updatedb                                 boolean false
d-i pkgsel/include                                  string bash-completion inetutils-tools keyboard-configuration openssh-server parted sudo

# ====== Post-Install =======================================================
# The following tasks are performed:
# * Handle 3-disk layout (separate disks for root, home, swap)
# * Set the keyboard layout (the installer does not set it!)
d-i preseed/late_command                            string \
 : "====== Partition Home and Swap disks in target ======================" ; \
 in-target /bin/sh -euxc ' \
   export PATH=/usr/sbin:/sbin:/usr/bin:/bin; \
   HOME_DISK="<SET_HOME_DISK_DEVICE_HERE>"; \
   SWAP_DISK="<SET_SWAP_DISK_DEVICE_HERE>"; \
   if [ -n "$HOME_DISK" ]; then \
     HOME_BASE="$(basename "$HOME_DISK")"; \
     ( cd /dev && [ -e "$HOME_BASE" ] || ./MAKEDEV "$HOME_BASE" ); \
     if dd if="$HOME_DISK" of=/dev/null bs=512 count=1 2>/dev/null; then \
       HOME_PART="${HOME_DISK}s1"; \
       parted -s "$HOME_DISK" mklabel msdos mkpart primary ext2 1MiB 100%; \
       ( cd /dev && ./MAKEDEV "${HOME_BASE}s1" ); \
       mke2fs -F -o hurd -L Home "$HOME_PART"; \
       mkdir -p /tmp/new_home; \
       mount -t ext2 "$HOME_PART" /tmp/new_home; \
       cp -a /home/. /tmp/new_home/; \
       umount /tmp/new_home; \
       rmdir /tmp/new_home; \
       rm -rf /home/* /home/.[!.]* /home/..?* 2>/dev/null || true; \
       grep -v "[[:space:]]/home[[:space:]]" /etc/fstab > /etc/fstab.new || true; \
       echo "$HOME_PART /home ext2 rw 0 2" >> /etc/fstab.new; \
       mv /etc/fstab.new /etc/fstab; \
     fi; \
   fi; \
   if [ -n "$SWAP_DISK" ]; then \
     SWAP_BASE="$(basename "$SWAP_DISK")"; \
     ( cd /dev && [ -e "$SWAP_BASE" ] || ./MAKEDEV "$SWAP_BASE" ); \
     if dd if="$SWAP_DISK" of=/dev/null bs=512 count=1 2>/dev/null; then \
       SWAP_PART="${SWAP_DISK}s1"; \
       parted -s "$SWAP_DISK" mklabel msdos mkpart primary linux-swap 1MiB 100%; \
       grep -v "[[:space:]]swap[[:space:]]" /etc/fstab > /etc/fstab.new || true; \
       echo "$SWAP_PART none swap sw 0 0" >> /etc/fstab.new; \
       mv /etc/fstab.new /etc/fstab; \
     fi; \
   fi \
 ' ; \
 : "====== Format Swap using d-i mkswap and persist /target/dev nodes ===" ; \
 /bin/sh -euxc ' \
   SWAP_DISK="<SET_SWAP_DISK_DEVICE_HERE>"; \
   if [ -n "$SWAP_DISK" ]; then \
     SWAP_BASE="$(basename "$SWAP_DISK")"; \
     MAKEDEV_BIN="$(command -v MAKEDEV || echo /dev/MAKEDEV)"; \
     ( cd /dev && [ -e "$SWAP_BASE" ] || "$MAKEDEV_BIN" "$SWAP_BASE" ); \
     if dd if="$SWAP_DISK" of=/dev/null bs=512 count=1 2>/dev/null; then \
       SWAP_PART="${SWAP_DISK}s1"; \
       ( cd /dev && [ -e "${SWAP_BASE}s1" ] || "$MAKEDEV_BIN" "${SWAP_BASE}s1" ); \
       mkswap "$SWAP_PART"; \
       ( cd /target/dev && [ -e "$SWAP_BASE" ] || "$MAKEDEV_BIN" "$SWAP_BASE" ); \
       ( cd /target/dev && [ -e "${SWAP_BASE}s1" ] || "$MAKEDEV_BIN" "${SWAP_BASE}s1" ); \
     fi; \
   fi \
 ' ; \
 : "====== Configure keyboard ============================================" ; \
 in-target /bin/sed -i "s/XKBMODEL=\"[a-z0-9]*\"/XKBMODEL=\"pc105\"/g" /etc/default/keyboard ; \
 in-target /bin/sed -i "s/XKBLAYOUT=\"[a-z]*\"/XKBLAYOUT=\"de\"/g" /etc/default/keyboard ; \
 in-target /bin/sed -i "s/XKBVARIANT=\"[a-z]*\"/XKBVARIANT=\"nodeadkeys\"/g" /etc/default/keyboard ; \
 in-target /bin/sed -i "s/XKBOPTIONS=\"[a-z]*\"/XKBOPTIONS=\"\"/g" /etc/default/keyboard ; \
 in-target /usr/sbin/dpkg-reconfigure -fnoninteractive keyboard-configuration ; \
 in-target /bin/sh -c 'if [ -f /etc/default/hurd-console ]; then sed -i "s/^ENABLE=.*/ENABLE='\''true'\''/" /etc/default/hurd-console; fi' ; \
 : "====== Further post-install ==========================================" ; \
 in-target true # <SET_POSTINSTALL_COMMANDS_HERE>

# ====== Reboot after installation ==========================================
d-i finish-install/reboot_in_progress               note
