#!/bin/sh

set -eux


# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# !!!! IMPORTANT:                                                         !!!!
# !!!! install.sites cannot be used directly. It needs to be in a tarball !!!!
# !!!! site.tgz, since there is no GZip in the installer environment!     !!!!
# !!!! On every change, this tarball MUST be regenerated by:              !!!!
# !!!! ./make-install.site-tarball                                        !!!!
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!


# ====== Find disks =========================================================
# Disk names extracted dynamically from sysctl hw.disknames
VALID_DISKS=""
for entry in $(sysctl -n hw.disknames | tr "," " ") ; do
   disk=$(echo "$entry" | cut -d: -f1)
   case "$disk" in
      cd*)
         # Skip CD drives and wedges
         ;;
      *)
         VALID_DISKS="$VALID_DISKS $disk"
         ;;
   esac
done

# Map to positional arguments:
set -- "$VALID_DISKS"

# DISK_ROOT="${1:-}"
DISK_HOME="${2:-}"
DISK_SWAP="${3:-}"

# ====== Partitioning =======================================================

# ------ Home disk ----------------------------------------------------------
if [ -n "$DISK_HOME" ]; then
   fdisk -gy "$DISK_HOME"
   echo "/home 1G-* 100%" | disklabel -wAT- "$DISK_HOME"
   newfs "/dev/r${DISK_HOME}a"

   DUID_HOME=$(disklabel "$DISK_HOME" | grep '^duid:' | awk '{ print $2 }')
   echo "${DUID_HOME}.a /home ffs rw,nodev,nosuid 1 2" >>/etc/fstab
fi

# ------ Swap disk ----------------------------------------------------------
if [ -n "$DISK_SWAP" ]; then
   fdisk -gy "$DISK_SWAP"
   echo "SWAP 1G-* 100%" | disklabel -wAT- "$DISK_SWAP"

   DUID_SWAP=$(disklabel "$DISK_SWAP" | grep '^duid:' | awk '{ print $2 }')
   echo "${DUID_SWAP}.b none swap sw 0 0" >>/etc/fstab
fi

# ====== Basic configuration ================================================

# ------ Configure console --------------------------------------------------
# sed -i "" 's/:setenv=/:lang=en_US.UTF-8:\/g' /etc/login.conf
# cap_mkdb /etc/login.conf

# ------ Install required packages ------------------------------------------
pkg_add -r -I bash sudo virt-what

# ====== User ===============================================================
echo "permit nopass <SET_USERNAME_HERE>" >/etc/doas.conf
chmod 0600 /etc/doas.conf

# Replicate your custom sudoers configuration
mkdir -p /etc/sudoers.d
echo "<SET_USERNAME_HERE> ALL=(ALL) NOPASSWD: ALL" >"/etc/sudoers.d/<SET_USERNAME_HERE>"
chmod 0440 "/etc/sudoers.d/<SET_USERNAME_HERE>"
