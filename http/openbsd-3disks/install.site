set -eux


# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# !!!! IMPORTANT:                                                         !!!!
# !!!! install.sites cannot be used directly. It needs to be in a tarball !!!!
# !!!! site.tgz, since there is no GZip in the installer environment!     !!!!
# !!!! On every change, this tarball MUST be regenerated by:              !!!!
# !!!! ./make-install.site-tarball                                        !!!!
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!


# ====== Partitioning =======================================================

# ------ Find disks ---------------------------------------------------------
# Disk names extracted dynamically from sysctl hw.disknames
VALID_DISKS=""
for entry in $(sysctl -n hw.disknames | tr "," " ") ; do
   disk=$(echo "$entry" | cut -d: -f1)
   case "$disk" in
      cd*)
         # Skip CD drives and wedges
         ;;
      *)
         VALID_DISKS="$VALID_DISKS $disk"
         ;;
   esac
done

# Map space-separated disk strings to positional parameters:
# shellcheck disable=SC2086
set -- $VALID_DISKS

DISK_ROOT="${1:-}"
DISK_HOME="${2:-}"
DISK_SWAP="${3:-}"

# ------ Home disk ----------------------------------------------------------
if [ -n "$DISK_HOME" ]; then
   fdisk -gy "$DISK_HOME"
   echo "/home 1G-* 100%" | disklabel -wAT- "$DISK_HOME"
   newfs "/dev/r${DISK_HOME}a"

   mkdir -p /tmp/home_disk
   mount "/dev/${DISK_HOME}a" /tmp/home_disk
   mv /home/* /tmp/home_disk/
   umount /tmp/home_disk
   rmdir /tmp/home_disk

   DUID_HOME=$(disklabel "$DISK_HOME" | grep '^duid:' | awk '{ print $2 }')
   echo "${DUID_HOME}.a /home ffs rw,nodev,nosuid 1 2" >>/etc/fstab
fi

# ------ Swap disk ----------------------------------------------------------
if [ -n "$DISK_SWAP" ]; then
   fdisk -gy "$DISK_SWAP"
   echo "SWAP 1G-* 100%" | disklabel -wAT- "$DISK_SWAP"

   DUID_SWAP=$(disklabel "$DISK_SWAP" | grep '^duid:' | awk '{ print $2 }')
   echo "${DUID_SWAP}.a none swap sw 0 0" >>/etc/fstab
fi

# ====== Basic configuration ================================================

# ------ Boot loader --------------------------------------------------------
cat >/etc/boot.conf <<EOF
tty pc0
set timeout 10
boot
EOF

# ------ Configure console --------------------------------------------------
# sed -i "" 's/:setenv=/:lang=en_US.UTF-8:\/g' /etc/login.conf
# cap_mkdb /etc/login.conf

echo "mouse.scaling=0.1" >/etc/wsconsctl.conf
rcctl enable wsmoused
rcctl start wsmoused || true

# ------ Install required packages ------------------------------------------
pkg_add -r -I bash sudo-- virt-what

# ====== QEMU Guest Agent ===================================================
# QEMU installs already need qemu-guest-agent before first boot:
if /usr/local/sbin/virt-what | grep -qx "kvm" ; then
   pkg_add -r -I qemu-ga
   rcctl enable qemu_ga
   # Guest agent has to use ISA serial port:
   # https://openports.pl/path/emulators/qemu,-ga
   rcctl set qemu_ga flags "-m isa-serial -p /dev/cua00"
   rcctl start qemu_ga || true
fi

# ====== User ===============================================================

user="$(id -nu 1000)"   # The user was already created by install.conf!

# ------ doas configuration -------------------------------------------------
echo "permit nopass $user" >/etc/doas.conf
chmod 0600 /etc/doas.conf

# ------ sudo configuration -------------------------------------------------
mkdir -p /etc/sudoers.d
echo "$user ALL=(ALL:ALL) NOPASSWD: ALL" >"/etc/sudoers.d/99-$user"
chmod 0440 "/etc/sudoers.d/99-$user"
if ! grep -q -E "^#(include|includedir) /etc/sudoers.d" /etc/sudoers ; then
   echo "" >>/etc/sudoers
   echo "#includedir /etc/sudoers.d" >>/etc/sudoers
fi

# ------ Shell configuration ------------------------------------------------
usermod -s /usr/local/bin/bash "$user"

# ====== Disable direct login as root user ==================================
usermod -p "*" root
