DISTRIBUTIONS="kernel.txz base.txz"
# NOTE: /usr/libexec/bsdinstall/zfsboot needs to be replaced with a custom
# script to perform the partitioning! ZFSBOOT_DISKS=dummy only makes sure
# that bsdinstall runs /usr/libexec/bsdinstall/zfsboot.
ZFSBOOT_DISKS="manual"

. /etc/os-release
_UNAME_R="$(uname -r)"
_UNAME_R="${_UNAME_R%-p*}"
export BSDINSTALL_DISTSITE="http://download.freebsd.org/ftp/releases/$(uname -m)/$(uname -p)/${_UNAME_R}"

export nonInteractive="YES"


# NOTE:
# For unknown reason FreeBSD 15.0's bsdinstall removes the existing
# resolv.conf, and dhclient fails to add it again. Make sure that
# at least some public DNS servers are there for installation:
echo 'nameserver 1.1.1.1' >>/tmp/bsdinstall_etc/resolv.conf
echo 'nameserver 1.0.0.1' >>/tmp/bsdinstall_etc/resolv.conf


#!/bin/sh

set -euxo pipefail

# ====== Basic configuration ================================================

# ------ Configure boot loader ----------------------------------------------
# Set autoboot delay:
echo 'autoboot_delay="5"' >>/boot/loader.conf

# Enable Newcons:
echo 'kern.vty=vt' >>/boot/loader.conf

# Enable SCTP support:
echo 'sctp_load="YES"' >>/boot/loader.conf

# ------ Configure console --------------------------------------------------
# FreeBSD now uses UTF-8 by default.
# Remove "lang=C.UTF-8", to apply the user's setting:
sed -e $'s#:lang=C.UTF-8:#::#g' </etc/login.conf >/etc/login.conf.new
mv /etc/login.conf.new /etc/login.conf
cap_mkdb /etc/login.conf

# ------ Configure keymap ---------------------------------------------------
sysrc keymap="<SET_XKBLAYOUT_HERE>"

# ------ Configure network --------------------------------------------------
sysrc hostname="<SET_HOSTFQDN_HERE>"

interface="$(ifconfig -l | cut -d' ' -f1)"
sysrc ifconfig_$interface="dhcp"
sysrc ifconfig_"$interface"_ipv6="inet6 accept_rtadv"
sysrc ipv6_activate_all_interfaces="YES"
sysrc ipv6_privacy="YES"

# ------ Configure time zone ------------------------------------------------
ln -sf /usr/share/zoneinfo/UTC /etc/localtime

# ------ Enable basic daemons -----------------------------------------------
sysrc zfs_enable="YES"

sysrc moused_enable="YES"
sysrc allscreens_flags="YES"

sysrc dumpdev="AUTO"
sysrc sshd_enable="YES"
sysrc ntpd_enable="YES"
sysrc ntp_leapfile_sources="https://data.iana.org/time-zones/data/leap-seconds.list"
sysrc ntp_leapfile_fetch_verbose="YES"
service ntpd fetch
# sysrc powerd_enable="YES"


# ====== Basic packages =====================================================

# ------ Run freebsd-update -------------------------------------------------
env PAGER=cat freebsd-update -v debug --not-running-from-cron fetch install || true

# ------ Configure package repositories -------------------------------------
mkdir -p /usr/local/etc/pkg/repos
cat >/usr/local/etc/pkg/repos/FreeBSD.conf <<EOF
# The quartery default repository is defined in /etc/pkg/FreeBSD.conf,
# named "FreeBSD-ports" (from FreeBSD 15.0) or "FreeBSD" (before FreeBSD 15.0):
FreeBSD-ports: { enabled: no }
FreeBSD: { enabled: no }

# Define "Quarterly" repository with the quarterly updates:
Quarterly: {
  url: "pkg+https://pkg.FreeBSD.org/\${ABI}/quarterly",
  mirror_type: "srv",
  signature_type: "fingerprints",
  fingerprints: "/usr/share/keys/pkg",
  enabled: no
}

# Define "Latest" repository with the latest updates:
Latest: {
  url: "pkg+https://pkg.FreeBSD.org/\${ABI}/latest",
  mirror_type: "srv",
  signature_type: "fingerprints",
  fingerprints: "/usr/share/keys/pkg",
  enabled: yes
}
EOF

# Initialise package database. pkg will ask whether to initialise,
# ASSUME_ALWAYS_YES=YES is necessary to prevent this! "-y" does *not* work!
env ASSUME_ALWAYS_YES=YES pkg bootstrap -f

# ------ Install required packages ------------------------------------------
pkg update
pkg upgrade -y
pkg install -y bash sudo virt-what


# ====== Bash profile link ==================================================
# Bash does not use /etc/profile, only /usr/local/etc/profile. This needs to
# be created, in order to get /etc/profile loaded!
# See: https://forums.freebsd.org/threads/what-happened-to-etc-profile.78406/
cat >/usr/local/etc/profile <<EOF
if [ "\${_loaded}" = "" ] ; then
   if [ -e /etc/profile ] ; then
      . /etc/profile
   fi
fi
EOF


# ====== QEMU Guest Agent ===================================================
# QEMU installs already need qemu-guest-agent before first boot:
if [ "$(/usr/local/sbin/virt-what)" = "kvm" ] ; then
   pkg install -y qemu-guest-agent
   sysrc qemu_guest_agent_enable="YES"
   service qemu-guest-agent start || true
fi


# ====== User ===============================================================
echo "<SET_PASSWORD_HERE>" | pw useradd -u 1000 -n "<SET_USERNAME_HERE>" -h 0 -s /bin/sh -G wheel -c "<SET_REALNAME_HERE>" -m

mkdir -p /usr/local/etc/sudoers.d
echo "<SET_USERNAME_HERE> ALL=(ALL) NOPASSWD: ALL" >"/usr/local/etc/sudoers.d/99-<SET_USERNAME_HERE>"
chmod 0600 "/usr/local/etc/sudoers.d/99-<SET_USERNAME_HERE>"

chsh -s /usr/local/bin/bash "<SET_USERNAME_HERE>"


# ====== Reimport ZFS pools =================================================
zpool list -Ho name | while read poolName ; do
   if [ "$poolName" != "zroot" ] ; then
      zpool export $poolName || true
      zpool import $poolName || true
   fi
done
zpool list


# ====== Reboot =============================================================

# Set boot order to boot from HDD, not from installer CD-ROM:
efibootmgr -o 0002,0001,0003,0004

# Reboot into the freshly installed system:
reboot
