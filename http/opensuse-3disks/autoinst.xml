<?xml version="1.0"?>
<!DOCTYPE profile>
<profile xmlns="http://www.suse.com/1.0/yast2ns" xmlns:config="http://www.suse.com/1.0/configns">

  <software>
    <products config:type="list">
      <product>Tumbleweed</product>
    </products>
    <patterns config:type="list">
      <pattern>base</pattern>
      <pattern>enhanced_base</pattern>
    </patterns>
  </software>

  <partitioning config:type="list">

    <drive>
      <device>/dev/sda</device>
      <initialize config:type="boolean">true</initialize>
      <partitions config:type="list">
        <partition>
          <mount>/boot/efi</mount>
          <size>64M</size>
          <filesystem>vfat</filesystem>
        </partition>
        <partition>
          <mount>/</mount>
          <size>max</size>
          <filesystem>btrfs</filesystem>
        </partition>
      </partitions>
    </drive>

    <drive>
      <device>/dev/sdb</device>
      <initialize config:type="boolean">true</initialize>
      <partitions config:type="list">
        <partition>
          <mount>/home</mount>
          <size>max</size>
          <filesystem>btrfs</filesystem>
        </partition>
      </partitions>
    </drive>

    <drive>
      <device>/dev/sdc</device>
      <initialize config:type="boolean">true</initialize>
      <partitions config:type="list">
        <partition>
          <mount>swap</mount>
          <size>max</size> <filesystem>swap</filesystem>
        </partition>
      </partitions>
    </drive>

  </partitioning>

  <users config:type="list">
    <user>
      <username>root</username>
      <user_password><![CDATA[<SET_PASSWORD_HERE>]]></user_password>
      <encrypted config:type="boolean">false</encrypted>
    </user>
    <user>
      <username><![CDATA[<SET_USERNAME_HERE>]]></username>
      <fullname><![CDATA[<SET_REALNAME_HERE>]]></fullname>
      <shell>/bin/bash</shell>
      <user_password><![CDATA[<SET_PASSWORD_HERE>]]></user_password>
      <encrypted config:type="boolean">false</encrypted>
    </user>
  </users>

  <scripts>
    <post-scripts config:type="list">
      <script>
        <filename>basic-setup.sh</filename>
        <source><![CDATA[#!/bin/bash
          # ------ Keyboard configuration -----------------------------------
          localectl set-xkb-map "<SET_XKBLAYOUT_HERE>" "<SET_XKBMODEL_HERE>" "<SET_XKBVARIANT_HERE>"

          # ------ Install required packages --------------------------------
          zypper --non-interactive install -y openssh virt-what

          # ------ Enable SSH server ----------------------------------------
          systemctl enable sshd
          firewall-offline-cmd --add-service=ssh

          # ------ sudo configuration ---------------------------------------
          usermod -a -G wheel "<SET_USERNAME_HERE>"

          echo "%wheel ALL=(ALL) ALL" >/etc/sudoers.d/wheel
          # Ask for the user's password instead of the root password:
          echo "Defaults !targetpw" >>/etc/sudoers.d/wheel
          chmod 0440 /etc/sudoers.d/wheel
        ]]></source>
      </script>
    </post-scripts>
  </scripts>

</profile>
