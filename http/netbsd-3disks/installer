#!/bin/sh

# Based on: https://github.com/stoned/packer-nbsd-boxes

export PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/pkg/sbin:/usr/pkg/bin

set -eux


# ====== Find disks =========================================================
# Disk names: sysctl hw.disknames
DISK_ROOT=""
for d in sd0 ; do
  if [ -e "/dev/$d" ]; then
    export DISK_ROOT=$d
    break
  fi
done
if [ "$DISK_ROOT" = "" ] ; then
   echo >&2 "ERROR: Root disk not found!"
   exit 1
fi

DISK_HOME=""
for d in sd1 ; do
  if [ -e "/dev/$d" ]; then
    export DISK_HOME=$d
    break
  fi
done
if [ "$DISK_HOME" = "" ] ; then
   echo >&2 "ERROR: Home disk not found!"
   exit 1
fi

DISK_SWAP=""
for d in sd2 ; do
  if [ -e "/dev/$d" ]; then
    export DISK_SWAP=$d
    break
  fi
done
if [ "$DISK_SWAP" = "" ] ; then
   echo >&2 "ERROR: Swap disk not found!"
   exit 1
fi


# ====== Partitioning =======================================================
# Root:
gpt create $DISK_ROOT
gpt add -t efi -s 64m $DISK_ROOT
gpt add -t ffs $DISK_ROOT
dkctl $DISK_ROOT listwedges
newfs_msdos /dev/rdk0
newfs -O 2 /dev/rdk1

# Home:
gpt create $DISK_HOME
gpt add -t ffs $DISK_HOME
dkctl $DISK_HOME listwedges
newfs -O 2 /dev/rdk2

# Swap:
gpt create $DISK_SWAP
gpt add -t swap $DISK_SWAP
dkctl $DISK_SWAP listwedges
swapctl -a /dev/dk3


