set -eux

export PATH=/sbin:/usr/sbin:/bin:/usr/bin:/usr/pkg/sbin:/usr/pkg/bin


# ====== Load ZFS kernel modules ============================================
modload solaris || true
modload zfs     || true


# ====== Find disks =========================================================
# ZFS pool names:
zfsRootPool="zroot"
zfsHomePool="zhome"

# Disk names extracted dynamically from sysctl hw.disknames
VALID_DISKS=""
for d in $(sysctl -n hw.disknames); do
  case "$d" in
    dk*|cd*|vnd*)
       # Skip CD drives, wedges, and vnd devices
       ;;
    *)
       VALID_DISKS="$VALID_DISKS $d"
       ;;
  esac
done

# Map space-separated disk strings to positional parameters:
# shellcheck disable=SC2086
set -- $VALID_DISKS

DISK_ROOT="${1:-}"
DISK_HOME="${2:-}"
DISK_SWAP="${3:-}"
if [ "$DISK_ROOT" = "" ] ; then
   echo >&2 "ERROR: Root disk not found!"
   exit 1
fi
if [ "$DISK_HOME" = "" ] ; then
   echo >&2 "ERROR: Home disk not found!"
   exit 1
fi
if [ "$DISK_SWAP" = "" ] ; then
   echo >&2 "ERROR: Swap disk not found!"
   exit 1
fi

echo "root=$DISK_ROOT home=$DISK_HOME swap=$DISK_SWAP"


# ====== Cleanup for idempotent re-runs =====================================
r=/targetroot

umount $r/boot/efi 2>/dev/null || true
umount $r/altboot  2>/dev/null || true
zfs unmount -a -f  2>/dev/null || true
umount -f $r       2>/dev/null || true
swapctl -d /dev/dk* 2>/dev/null || true

zpool destroy -f "$zfsRootPool" 2>/dev/null || true
zpool destroy -f "$zfsHomePool" 2>/dev/null || true

for disk in "$DISK_ROOT" "$DISK_HOME" "$DISK_SWAP"; do
   for w in $(dkctl "$disk" listwedges 2>/dev/null | awk -F: '/^dk/ { print $1 }'); do
      dkctl "$disk" delwedge "$w" 2>/dev/null || true
   done
   gpt destroy "$disk" 2>/dev/null || true
done


# ====== Partitioning =======================================================
# Documentation:
# https://wiki.netbsd.org/Installation_on_UEFI_systems/

# Root Disk (EFI + FFS /altboot + ZFS zroot):
gpt create "$DISK_ROOT"
gpt add -a 4k -l "EFI"  -t efi -s 64m "$DISK_ROOT"
gpt add -a 4k -l "Boot" -t ffs -s 1g  "$DISK_ROOT"
gpt add -a 4k -l "Root" -t zfs        "$DISK_ROOT"

# Find assigned wedge IDs for Root Disk:
WEDGE_EFI=$(dkctl "$DISK_ROOT" listwedges | grep "EFI"  | awk -F: '{ print $1 }' | tr -d ' ')
WEDGE_BOOT=$(dkctl "$DISK_ROOT" listwedges | grep "Boot" | awk -F: '{ print $1 }' | tr -d ' ')
WEDGE_ROOT=$(dkctl "$DISK_ROOT" listwedges | grep "Root" | awk -F: '{ print $1 }' | tr -d ' ')

newfs_msdos /dev/r"$WEDGE_EFI"
newfs -O 2 /dev/r"$WEDGE_BOOT"

# Home Disk (ZFS zhome):
gpt create "$DISK_HOME"
gpt add -a 4k -l "Home" -t zfs "$DISK_HOME"

# Find assigned wedge ID for Home Disk:
WEDGE_HOME=$(dkctl "$DISK_HOME" listwedges | grep "Home" | awk -F: '{ print $1 }' | tr -d ' ')

# Swap Disk:
gpt create "$DISK_SWAP"
gpt add -a 4k -l "Swap" -t swap "$DISK_SWAP"

# Find assigned wedge ID for Swap Disk:
WEDGE_SWAP=$(dkctl "$DISK_SWAP" listwedges | grep "Swap" | awk -F: '{ print $1 }' | tr -d ' ')
swapctl -a /dev/"$WEDGE_SWAP"


# ====== ZFS Pools and Datasets =============================================
mkdir -p $r

# ------ Create ZFS Root Pool -----------------------------------------------
zpool create -f -m none -o altroot=$r -o cachefile=/tmp/zpool.cache "$zfsRootPool" /dev/"$WEDGE_ROOT"
zfs set compression=on "$zfsRootPool"

zfs create -o mountpoint=none   "$zfsRootPool/ROOT"
zfs create -o mountpoint=legacy "$zfsRootPool/ROOT/default"
mount -t zfs "$zfsRootPool/ROOT/default" $r

zfs create -o mountpoint=/tmp  -o exec=on      -o setuid=off   "$zfsRootPool/tmp"
zfs create -o canmount=off -o mountpoint=/usr                  "$zfsRootPool/usr"
zfs create                     -o exec=off     -o setuid=off   "$zfsRootPool/usr/src"
zfs create                                                     "$zfsRootPool/usr/obj"
zfs create -o mountpoint=/usr/pkgsrc -o exec=on -o setuid=off  "$zfsRootPool/usr/pkgsrc"
zfs create                     -o exec=off     -o setuid=off   "$zfsRootPool/usr/pkgsrc/distfiles"
zfs create                     -o exec=off     -o setuid=off   "$zfsRootPool/usr/pkgsrc/packages"
zfs create -o canmount=off -o mountpoint=/var                  "$zfsRootPool/var"
zfs create                     -o exec=off     -o setuid=off   "$zfsRootPool/var/crash"
zfs create                     -o exec=off     -o setuid=off   "$zfsRootPool/var/log"
zfs create -o atime=on         -o exec=off     -o setuid=off   "$zfsRootPool/var/mail"
zfs create                     -o exec=on      -o setuid=off   "$zfsRootPool/var/tmp"

chmod 1777 $r/var/tmp
chmod 1777 $r/tmp

zpool set bootfs="$zfsRootPool/ROOT/default" "$zfsRootPool"

# ------ Create ZFS Home Pool -----------------------------------------------
zpool create -f -m none -o altroot=$r -o cachefile=/tmp/zpool.cache "$zfsHomePool" /dev/"$WEDGE_HOME"
zfs set compression=on "$zfsHomePool"

zfs create -o mountpoint=none  "$zfsHomePool/HOME"
zfs create -o mountpoint=/home "$zfsHomePool/HOME/default"

# ------ Mount FFS Boot and EFI partitions ----------------------------------
mkdir -p $r/altboot
mount -o async /dev/"$WEDGE_BOOT" $r/altboot
mkdir -p $r/boot/efi
mount /dev/"$WEDGE_EFI" $r/boot/efi


# ====== NetBSD installation ================================================

# ------ Extract sets -------------------------------------------------------
suffix=tgz
[ -f /amd64/binary/sets/base.tar.xz ] && suffix=tar.xz

for s in base comp etc games kern-GENERIC man misc modules tests text xbase xcomp xetc xfont xserver ; do
   ( cd $r && echo $s && tar --chroot -xpf /amd64/binary/sets/$s.$suffix )
done

# Copy ZFS pool cache into target system:
mkdir -p $r/etc/zfs
cp /tmp/zpool.cache $r/etc/zfs/zpool.cache

# MAKEDEV
( cd $r/dev && sh ./MAKEDEV all )

# Enable solaris and zfs kernel modules at boot:
cat <<EOF >>$r/etc/modules.conf
solaris
zfs
EOF

# fstab (ZFS mounts / and /home via ramdisk-zfsroot.fs and rc.d/zfs):
mkdir -p $r/kern
mkdir -p $r/proc
cat <<EOF >$r/etc/fstab
NAME=Boot        /altboot     ffs     rw,log,noatime 1 2
NAME=EFI         /boot/efi    msdos   rw             0 0
NAME=Swap        none         swap    sw,dp          0 0
kernfs           /kern        kernfs  rw             0 0
procfs           /proc        procfs  rw             0 0
fdesc            /dev         fdesc   ro,-o=union    0 0
ptyfs            /dev/pts     ptyfs   rw             0 0
EOF


# ====== Boot loader and ZFS root ramdisk ===================================
RELEASE="$(uname -r)"
ARCH="$(uname -m)"

# Copy kernel and modules to FFS /altboot:
cp $r/netbsd $r/altboot/netbsd
cp -R $r/stand $r/altboot/stand

# Obtain ramdisk-zfsroot.fs from ISO or NetBSD CDN:
if [ -f "/$ARCH/installation/ramdisk/ramdisk-zfsroot.fs" ]; then
   cp "/$ARCH/installation/ramdisk/ramdisk-zfsroot.fs" $r/altboot/ramdisk-zfsroot.fs
else
   ftp -o $r/altboot/ramdisk-zfsroot.fs \
      "https://www.nic.funet.fi/pub/NetBSD/NetBSD-$RELEASE/$ARCH/installation/ramdisk/ramdisk-zfsroot.fs"
fi

# Patch ramdisk-zfsroot.fs so it imports zroot and mounts zroot/ROOT/default:
RAMDISK_MNT="$(mktemp -d /tmp/zfsramdisk.XXXXXX)"
vnconfig vnd0 $r/altboot/ramdisk-zfsroot.fs
mount /dev/vnd0a "$RAMDISK_MNT"

cat "$RAMDISK_MNT/etc/rc"
sed -i -e 's|\([=/"-]\)ROOT\([}"[:space:];]\)|\1ROOT/default\2|g' \
       -e 's|\([=/"-]\)ROOT$|\1ROOT/default|g' \
       -e "s|rpool|${zfsRootPool}|g" \
       "$RAMDISK_MNT/etc/rc"
cat "$RAMDISK_MNT/etc/rc"
grep -q "ROOT/default" "$RAMDISK_MNT/etc/rc"

umount "$RAMDISK_MNT"
vnconfig -u vnd0
rmdir "$RAMDISK_MNT"

# Configure UEFI bootloader and boot.cfg with explicit NAME=Boot paths:
mkdir -p $r/boot/efi/EFI/BOOT
mkdir -p $r/boot/efi/EFI/NetBSD
cp /usr/mdec/bootx64.efi $r/boot/efi/EFI/BOOT/BOOTX64.EFI

cat <<EOF >$r/altboot/boot.cfg
menu=Boot NetBSD ZFS:load NAME=Boot:/stand/$ARCH/$RELEASE/modules/solaris/solaris.kmod;load NAME=Boot:/stand/$ARCH/$RELEASE/modules/zfs/zfs.kmod;fs NAME=Boot:/ramdisk-zfsroot.fs;boot NAME=Boot:/netbsd
default=1
timeout=2
EOF
cp $r/altboot/boot.cfg $r/boot/efi/EFI/NetBSD/boot.cfg
cp $r/altboot/boot.cfg $r/boot/efi/boot.cfg

( cd $r/boot/efi && efi -q -c -l "\\EFI\\BOOT\\BOOTX64.EFI" -L "NetBSD" )


# ====== Basic configuration ================================================

# ------ Configure console --------------------------------------------------
echo 'wscons="YES"' >>$r/etc/rc.conf
echo 'wsmoused="YES"' >>$r/etc/rc.conf
cat >>"$r/etc/profile" <<EOF
export LANG="C.UTF-8"
export LC_CTYPE="C.UTF-8"
EOF

# ------ Configure keymap ---------------------------------------------------
keymap="<SET_XKBLAYOUT_HERE>"
if grep -q "^encoding" "$r/etc/wscons.conf"; then
   sed -i "s/^encoding.*/encoding $keymap/" "$r/etc/wscons.conf"
else
   echo "encoding $keymap" >>"$r/etc/wscons.conf"
fi
chroot $r wsconsctl -w encoding=$keymap

# ------ Configure network --------------------------------------------------
interface="$(ifconfig -l | cut -d' ' -f1)"

# shellcheck disable=SC2129
cat >>$r/etc/rc.conf <<EOF
hostname="<SET_HOSTFQDN_HERE>"
ifconfig_$interface="dhcp"
EOF

# ------ Configure time zone ------------------------------------------------
chroot $r ln -sf /usr/share/zoneinfo/UTC /etc/localtime

# ------ Enable basic daemons -----------------------------------------------
echo 'zfs="YES"' >>$r/etc/rc.conf
echo 'sshd="YES"' >>$r/etc/rc.conf

# Ensure zhome imports cleanly on service start before zfs mount -a runs:
mkdir -p $r/etc/rc.conf.d
cat <<EOF >$r/etc/rc.conf.d/zfs
zfs_import_zhome() {
   \${zfs_orig_precmd:-:}
   /sbin/zpool import -f -N $zfsHomePool 2>/dev/null || true
}
if [ "\${start_precmd:-}" != "zfs_import_zhome" ]; then
   zfs_orig_precmd="\${start_precmd:-:}"
   start_precmd="zfs_import_zhome"
fi
EOF

# Update rc_configured:
sed -e 's/^rc_configured=NO/rc_configured="YES"/' \
   $r/etc/rc.conf >/tmp/rc.conf.updated
mv /tmp/rc.conf.updated $r/etc/rc.conf

# Ensure that current DNS configuration and TLS certificates are available:
cp /etc/resolv.conf "$r/etc/resolv.conf"
cp -R /etc/openssl/certs "$r/etc/openssl/"
cp /etc/openssl/certs.conf "$r/etc/openssl/"

# ------ Initialise package database ----------------------------------------
pkgsrcURL="https://cdn.netbsd.org/pub/pkgsrc/packages/NetBSD"
# pkgsrcURL="https://ftp.netbsd.org/pub/pkgsrc/packages/NetBSD"
arch="$(uname -p)"
release="$(uname -r | cut -d_ -f1)"   # _2026Q2

chroot $r certctl rehash
chroot $r pkg_add -v "$pkgsrcURL/$arch/$release/All/pkgin"
# shellcheck disable=SC2016
sed -e 's,^[^#].*$,'"$pkgsrcURL"'/$arch/'"$release"'/All,' \
   $r/usr/pkg/etc/pkgin/repositories.conf >/tmp/repositories.conf
mv /tmp/repositories.conf $r/usr/pkg/etc/pkgin/repositories.conf
chroot $r pkgin -y update

# ------ Install required packages ------------------------------------------
chroot $r /usr/pkg/bin/pkgin -y install bash sudo


# ====== Enable SCTP ========================================================
chroot $r sh <<EOF
set -eu

ARCH="\$(uname -m)"
RELEASE="\$(uname -r)"
CONF_DIR="/usr/src/sys/arch/\$ARCH/conf"
NEW_CONF="CUSTOM_SCTP"

if [ ! -d "\$CONF_DIR" ]; then
    URL="https://www.nic.funet.fi/pub/NetBSD/NetBSD-\$RELEASE/source/sets/syssrc.tgz"
    tempDirectory="\$(mktemp -d /tmp/netbsd-src.XXXXXX)"
    cd "\$tempDirectory"
    ftp "\$URL"
    tar -xzpf syssrc.tgz -C /
    cd /
    rm -rf "\$tempDirectory"
fi

cd "\$CONF_DIR"
sed '/options[[:space:]]\\{1,\\}INET/a\\
options         SCTP            # Stream Control Transmission Protocol support
' GENERIC >CUSTOM_SCTP

config "\$NEW_CONF"
cd "../compile/\$NEW_CONF"

NCPU="\$(sysctl -n hw.ncpu)"
export MAKEFLAGS="-j \${NCPU}"
make depend
make

if [ -f /netbsd ]; then
   mv /netbsd /netbsd.old
fi
cp netbsd /netbsd
if [ -f /altboot/netbsd ]; then
   mv /altboot/netbsd /altboot/netbsd.old
fi
cp netbsd /altboot/netbsd
EOF


# ====== QEMU Guest Agent ===================================================
# QEMU installs already need qemu-guest-agent before first boot:
case "$(/sbin/sysctl -n machdep.dmi.system-vendor machdep.dmi.system-product 2>/dev/null || true)" in
   *QEMU*|*KVM*)
      chroot $r pkgin -y install qemu-guest-agent
      cp $r/usr/pkg/share/examples/rc.d/qemu-guest-agent $r/etc/rc.d/
      echo 'qemu_guest_agent="YES"' >>$r/etc/rc.conf
      ;;
esac


# ====== User ===============================================================

# ------ Create user --------------------------------------------------------
userPasswordHash="$(chroot $r pwhash "<SET_PASSWORD_HERE>")"

chroot $r groupadd "<SET_USERNAME_HERE>"
chroot $r useradd -u 1000 -g "<SET_USERNAME_HERE>" \
   -m -G wheel \
   -s /usr/pkg/bin/bash \
   -p "$userPasswordHash" \
   -c "<SET_REALNAME_HERE>" \
   "<SET_USERNAME_HERE>"

# ------ sudo configuration -------------------------------------------------
mkdir -p $r/usr/pkg/etc/sudoers.d
echo "<SET_USERNAME_HERE> ALL=(ALL) NOPASSWD: ALL" \
   >"$r/usr/pkg/etc/sudoers.d/99-<SET_USERNAME_HERE>"
chmod 0440 "$r/usr/pkg/etc/sudoers.d/99-<SET_USERNAME_HERE>"


# ====== Disable direct login as root user ==================================
chroot $r sed -e 's/^root:[^:]*/root:*/' -i /etc/master.passwd
chroot $r pwd_mkdb -p /etc/master.passwd


# ====== Clean unmount & ZFS pool export ====================================
umount $r/boot/efi
umount $r/altboot
zfs unmount -a -f
umount -f $r

zpool export "$zfsHomePool"
zpool export "$zfsRootPool"


# ====== Reboot =============================================================

# Reboot into the freshly installed system:
reboot
