autoinstall:
  # ###### Installer Configuration ##########################################
  version: 1
  refresh-installer:
    update: true
    channel: stable


  # ###### Locale and Keyboard Configuration ################################
  # Using Irish locale (€, metric units, etc.), but late-commands sets British
  # time format (24-hour clock). Other locales are added in late-command!
  locale: en_IE.UTF-8
  keyboard:
    layout: <SET_XKBLAYOUT_HERE>
    variant: <SET_XKBVARIANT_HERE>


  # ###### Storage Configuration ############################################
  storage:
    grub:
      reorder_uefi: false
    swap:
      size: 0

    config:
      # ====== Disks ========================================================
      - type: disk
        id: disk0
        name: "system-disk"
        path: <SET_ROOT_DISK_DEVICE_HERE>
        wipe: superblock
        ptable: gpt
        preserve: false
        grub_device: true
      - type: disk
        id: disk1
        name: "home-disk"
        path: <SET_HOME_DISK_DEVICE_HERE>
        wipe: superblock
        ptable: gpt
        preserve: false
        grub_device: false
      - type: disk
        id: disk2
        name: "swap-disk"
        path: <SET_SWAP_DISK_DEVICE_HERE>
        wipe: superblock
        ptable: gpt
        preserve: false
        grub_device: false

      # ====== BIOS Grub ====================================================
      # NOTE: Will be created later manually!
      # - id: disk0-partition-grub
      #   type: partition
      #   device: disk0
      #   size: 1048576
      #   flag: bios_grub
      #   #grub_device: true
      #   preserve: false

      # ====== EFI ==========================================================
      - id: disk0-partition-efi
        type: partition
        device: disk0
        size: 31457280
        flag: boot
        grub_device: true
        preserve: false
      - id: disk0-partition-efi-format
        type: format
        fstype: fat16
        label: EFI
        volume: disk0-partition-efi
        preserve: false

      # ====== /boot ========================================================
      - id: disk0-partition-boot
        type: partition
        device: disk0
        size: 536870912
        flag: linux
        grub_device: false
        preserve: false
      - id: disk0-partition-boot-format
        type: format
        fstype: ext4
        label: Boot
        volume: disk0-partition-boot
        preserve: false

      # ====== / ============================================================
      - id: disk0-partition-root
        type: partition
        device: disk0
        size: -1
        flag: linux
        grub_device: false
        preserve: false
      - id: disk0-partition-root-format
        type: format
        fstype: btrfs
        label: System
        volume: disk0-partition-root
        preserve: false

      # ====== Home =========================================================
      - id: disk1-partition-home
        type: partition
        device: disk1
        size: -1
        flag: linux
        grub_device: false
        preserve: false
      - id: disk1-partition-home-format
        type: format
        fstype: btrfs
        label: Home
        volume: disk1-partition-home
        preserve: false

      # ====== Swap =========================================================
      - id: disk2-partition-swap
        type: partition
        device: disk2
        size: -1
        flag: linux
        grub_device: false
        preserve: false
      - id: disk2-partition-swap-format
        type: format
        fstype: swap
        label: Swap
        volume: disk2-partition-swap
        preserve: false

      # ====== Mount points =================================================
      - id: disk0-partition-system-mount
        type: mount
        path: /
        device: disk0-partition-root-format
        preserve: false
      - id: disk0-partition-boot-mount
        type: mount
        path: /boot
        device: disk0-partition-boot-format
        preserve: false
      - id: disk0-partition-efi-mount
        type: mount
        path: /boot/efi
        device: disk0-partition-efi-format
        preserve: false
      - id: disk1-partition-home-mount
        type: mount
        path: /home
        device: disk1-partition-home-format
        preserve: false
      - id: disk2-partition-swap-mount
        type: mount
        path: none
        device: disk2-partition-swap-format
        preserve: false


  # ###### Host and User Configuration ######################################
  identity:
    hostname: <SET_HOSTFQDN_HERE>
    username: <SET_USERNAME_HERE>
    realname: "<SET_REALNAME_HERE>"
    password: "<SET_HASHED_PASSWORD_HERE>"


  # ###### Package Management ###############################################
  apt:
    preserve_sources_list: false
    geoip: true
    primary:
      - arches: [default]
        uri: "http://dk.archive.ubuntu.com/ubuntu"
  packages:
    - qemu-guest-agent
    - virt-what
  ssh:
    install-server: true


  # ###### Post-Install Configuration #######################################
  late-commands:
    # ====== QEMU Guest Agent ===============================================
    - |
      set -eux
      # qemu-guest-agent has to be installed in advance, since apt-get
      # cannot download here any more => remove, if unnecessary.
      if [ ! "$(chroot /target virt-what)" = "kvm" ] ; then
         chroot /target apt-get autoremove --purge -y qemu-guest-agent
      fi

    # ====== Let Netplan ask the DHCP or DNS server for the hostname ========
    - |
      set -eux
      if [ "$(hostname)" = "localhost" ] ; then
         chroot /target rm -f /etc/hostname
      fi

    # ====== Add partition names ============================================
    - |
      set -eux

      sgdisk --change-name=1:EFI --change-name=2:Boot --change-name=3:Root <SET_ROOT_DISK_DEVICE_HERE>
      if [ -e <SET_HOME_DISK_DEVICE_HERE> ] ; then
         sgdisk --change-name=1:Home <SET_HOME_DISK_DEVICE_HERE>
      fi
      if [ -e <SET_SWAP_DISK_DEVICE_HERE> ] ; then
         sgdisk --change-name=1:Swap --typecode=1:8200 <SET_SWAP_DISK_DEVICE_HERE>
      fi

    # ====== BTRFS subvolume setup ==========================================
    - |
      set -eux

      # ------ 1. Obtain devices and their UUIDs ----------------------------
      EFI_DEV="$(awk '$2 == "/target/boot/efi" { print $1 }' /proc/mounts)"
      BOOT_DEV="$(awk '$2 == "/target/boot" { print $1 }' /proc/mounts)"
      ROOT_DEV="$(awk '$2 ~ "^/target$" { print $1 }' /proc/mounts)"
      ROOT_UUID="$(blkid -s UUID -o value "$ROOT_DEV")"

      HOME_DEV=""
      HOME_UUID=""
      if [ -e <SET_HOME_DISK_DEVICE_HERE> ] ; then
         HOME_DEV="$(awk '$2 ~ "^/target/home$" { print $1 }' /proc/mounts)"
         HOME_UUID="$(blkid -s UUID -o value "$HOME_DEV")"
      fi
      SWAP_DEV=""
      SWAP_UUID=""
      if [ -e <SET_SWAP_DISK_DEVICE_HERE> ] ; then
         SWAP_DEV="<SET_SWAP_DISK_DEVICE_HERE>1"
         SWAP_UUID="$(blkid -s UUID -o value "$SWAP_DEV")"
      fi

      # ------ 2. Create snapshots: @ for / and @home for /home -------------
      btrfs subvolume snapshot /target /target/@
      if [ -n "$HOME_UUID" ] ; then
         btrfs subvolume snapshot /target/home /target/home/@home
         find /target/home -mindepth 1 -maxdepth 1 -not -name @home -exec rm -rf '{}' \;
      fi

      # ------ 3. Unmount child mounts in reverse order ---------------------
      awk '$2 ~ "^/target/" { print $2 }' /proc/mounts | sort -r | xargs -r umount
      # Clean up top-level Btrfs root volume:
      find /target -mindepth 1 -maxdepth 1 -not -name @ -exec rm -rf '{}' \;

      # ------ 4. Unmount /target and remount subvolume @ to /target --------
      umount /target
      mount -o subvol=@ "$ROOT_DEV" /target

      if [ -n "$HOME_UUID" ] ; then
         mount -o subvol=@home "$HOME_DEV" /target/home
      else
         # If no separate home disk, create subvolume inside root disk:
         mkdir -p /mnt/btrfs-top
         mount -o subvolid=5 "$ROOT_DEV" /mnt/btrfs-top
         btrfs subvolume create /mnt/btrfs-top/@home
         umount /mnt/btrfs-top
         mount -o subvol=@home "$ROOT_DEV" /target/home
         echo "UUID=$ROOT_UUID /home btrfs defaults,subvol=@home 0 0" >> /target/etc/fstab
      fi

      # Mount Boot and EFI under /target:
      mount "$BOOT_DEV" /target/boot
      mkdir -p /target/boot/efi
      mount "$EFI_DEV" /target/boot/efi

      # ------ 5. Update /etc/fstab -----------------------------------------
      sed -i "/$ROOT_UUID/s/defaults/defaults,subvol=@/" /target/etc/fstab
      if [ -n "$HOME_UUID" ] ; then
         sed -i "/$HOME_UUID/s/defaults/defaults,subvol=@home/" /target/etc/fstab
      fi
      if [ -n "$SWAP_UUID" ] ; then
         sed -i "/$SWAP_UUID/s/ sw / sw,discard /" /target/etc/fstab
      fi

      # ------ 6. Reinstall GRUB and update config --------------------------
      mount -o bind /dev  /target/dev
      mount -o bind /sys  /target/sys
      mount -o bind /proc /target/proc
      mount -o bind /run  /target/run
      mount -o bind /sys/firmware/efi/efivars /target/sys/firmware/efi/efivars

      chroot /target update-grub
      chroot /target grub-install --efi-directory=/boot/efi

      # Unbind virtual mounts
      # (leaves /target, /target/boot, /target/boot/efi, /target/home intact):
      umount /target/sys/firmware/efi/efivars /target/proc /target/sys /target/run /target/dev

    # # ====== Remove snapd (can be installed explicitly later, if needed) ====
    # - |
    #   chroot /target apt-get autoremove -y --purge snapd
    #   echo -en "# Prevent the installation of snapd:\nPackage: snapd\nPin: release a=*\nPin-Priority: -16\n" >/target/etc/apt/preferences.d/block-snapd.pref
