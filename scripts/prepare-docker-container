# POSIX Shell options:
set -eu


# ###### Print script name, to make Packer output easier readable ###########
if command -v figlet >/dev/null && command -v print-utf8 >/dev/null ; then
   echo
   LC_ALL=C.UTF-8 print-utf8 -x 160 -n -s "\e[1;32m█" "▀" "█\e[0m"
   figlet -w 156 "$(basename "$0")" | LC_ALL=C.UTF-8 print-utf8 -x 160 -n -C "\e[1;32m█\e[22m" "\e[1;32m█\e[0m"
   LC_ALL=C.UTF-8 print-utf8 -x 160 -n -s "\e[1;32m█" "▄" "█\e[0m"
else
   printf "\x1b[1;34;22m########## %s ##########\033[0m\n" "$(basename "$0")"
fi

# Enable printing the command-lines executed:
set -x


# ###### Main program #######################################################

# ====== Check/set environment variables ====================================
if [ -z "${USER_NAME:-}" ] || [ -z "${USER_REALNAME:-}" ] || [ -z "${USER_PASSWORD:-}" ] ; then
   echo "Usage: env USER_NAME=<user> USER_REALNAME=\"<full user name>\" USER_PASSWORD=\"<password>\" $0" >&2
   echo "Example: sudo env USER_NAME=nornetpp USER_REALNAME=\"NorNet Praesum Presum\" USER_PASSWORD=\"test\" $0" >&2
   exit 1
fi

# ====== Obtain system details ==============================================
UNAME="$(uname)"
NAME="${UNAME}"
ID=$(echo "$UNAME" | tr '[:upper:]' '[:lower:]')
VERSION="$(uname -r)"
VERSION_ID="${VERSION%%_*}"
if [ -f /etc/os-release ] ; then
   . /etc/os-release
fi

# ====== Make sure that "sudo" is available =================================

# ------ Ubuntu/Debian ------------------------------------------------------
case "${ID}" in
   ubuntu|debian)
      # apt-show-versions does not work with compressed indices:
      # https://askubuntu.com/questions/916199/install-apt-show-versions-inside-an-ubuntu-docker-container
      rm -f /etc/apt/apt.conf.d/docker-gzip-indexes

      apt-get update -qq
      env DEBIAN_FRONTEND=noninteractive apt-get install -y sudo
      ;;
   fedora)
      dnf install --setopt=install_weak_deps=False -y sudo
      ;;
   opensuse-*)
      zypper --non-interactive install --no-recommends -y bash sudo system-group-wheel
      ;;
   alpine)
      apk add bash doas shadow sudo
      ;;
   *)
      echo "ERROR: Unknown ID ${ID} in /etc/os-release. The installation script may need an update for supporting this system!" >&2
      exit 1
      ;;
esac

# ====== Create user ========================================================
mkdir -p "/home/${USER_NAME}"
groupadd "${USER_NAME}"
useradd -s /bin/bash \
   -c "${USER_REALNAME}" \
   -g "${USER_NAME}" \
   -d "/home/${USER_NAME}" \
   -p "${USER_PASSWORD}" \
   "${USER_NAME}"
echo "${USER_NAME}:${USER_PASSWORD}" | chpasswd
chown "${USER_NAME}:${USER_NAME}" "/home/${USER_NAME}"

case "${ID}" in
   ubuntu|debian)
      # Debian/Ubuntu: group is "sudo"
      usermod -aG sudo "${USER_NAME}"
      ;;
   fedora|opensuse-*)
      # Fedora/OpenSUSE: group is "wheel"
      usermod -aG wheel "${USER_NAME}"
      echo "${USER_NAME} ALL=(ALL) NOPASSWD: ALL" >"/etc/sudoers.d/99-${USER_NAME}"
      chmod 0600 "/etc/sudoers.d/99-${USER_NAME}"
      ;;
   alpine)
      echo 'permit nopass :wheel' >/etc/doas.d/wheel.conf
      usermod -aG wheel "${USER_NAME}"
      sed -e 's/^# %wheel ALL=(ALL:ALL) NOPASSWD: ALL/%wheel ALL=(ALL:ALL) NOPASSWD: ALL/' -i /etc/sudoers
      ;;
esac


# ====== Make sure that "systemctl" is available ============================
case "${ID}" in
   ubuntu|debian)
      env DEBIAN_FRONTEND=noninteractive apt-get install -y systemctl || true
      ;;
   fedora)
      dnf install --setopt=install_weak_deps=False -y systemd
      ;;
   opensuse-*)
      # openSUSE includes systemctl inside the main systemd package
      zypper --non-interactive install --no-recommends -y systemd || true
      ;;
   alpine)
      apk add openrc
      ;;
esac
