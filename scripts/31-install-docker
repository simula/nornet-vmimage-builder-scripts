# Contact: thomas.dreibholz@gmail.com

# Bash options:
set -euo pipefail


# ###### Print script name, to make Packer output easier readable ###########
SCRIPT="31-install-docker"   # Set to "$(basename "$0")" of this file!
if command -v figlet >/dev/null && command -v print-utf8 >/dev/null ; then
   echo
   LC_ALL=C.UTF-8 print-utf8 -x 160 -n -s "\e[1;31m█" "▀" "█\e[0m"
   figlet -w 156 "${SCRIPT}" | LC_ALL=C.UTF-8 print-utf8 -x 160 -n -C "\e[1;31m█\e[22m" "\e[1;31m█\e[0m"
   LC_ALL=C.UTF-8 print-utf8 -x 160 -n -s "\e[1;31m█" "▄" "█\e[0m"
else
   echo -e "\e[1;31;22m########## ${SCRIPT} ##########\e[0m"
fi

# Enable printing the command-lines executed:
set -x


# ###### Main program #######################################################

# ====== Check/set environment variables ====================================
if [ ! -v USER_NAME ] || [ "${USER_NAME}" == "" ] ; then
   echo >&2 "Usage: env USER_NAME=<user> $0"
   echo >&2 "Example: sudo env USER_NAME=nornetpp $0"
   exit 1
fi

# ====== Obtain system details ==============================================
UNAME="$(uname)"
NAME="${UNAME}"
ID="${UNAME,,}"
VERSION="$(uname -r)"
VERSION_ID="${VERSION/_*/}"
if [ -f /etc/os-release ] ; then
   . /etc/os-release
fi


# ====== Package installation ===============================================
architecture="$(uname -m)"
if [[ ! "${architecture}" =~ ^(amd64|x86_64|arm64|aarch64)$ ]] ; then
   echo "Docker is (currently) only available on AMD64 and ARM64 => nothing to do here!"
   exit 0
fi

# ------ Ubuntu/Debian ------------------------------------------------------
if [ "${ID}" == "ubuntu" ] || [ "${ID}" == "debian" ] ; then

   if [ "${ID}" == "ubuntu" ] ; then
      if [[ "${VERSION_ID}" =~ ^(1[2-9]\.[01][04]|2[01]\.[01][04])$ ]] ; then
         # Old Ubuntu versions do not have docker-buildx and docker-cli:
         packages=( containerd docker.io docker-compose )
      else
         packages=( containerd docker.io docker-buildx docker-cli docker-compose-v2 )
      fi
   elif [ "${ID}" == "debian" ] ; then
      if [[ "${VERSION_ID}" =~ ^[0-9]+$  ]] && [[ "${VERSION_ID}" -lt 13 ]] ; then
         # Old Debian versions do not have docker-buildx and docker-cli:
         packages=( containerd docker.io docker-compose )
      else
         packages=( containerd docker.io docker-buildx docker-cli docker-compose )
      fi
   else
      echo >&2 "ERROR: Inexpected ID ${ID}!"
      exit 1
   fi

   env DEBIAN_FRONTEND=noninteractive apt-get install -y -m --no-install-recommends "${packages[@]}"

   # Add user to "docker" group:
   usermod -a -G docker "${USER_NAME}"


# ------ Fedora -------------------------------------------------------------
elif [ "${ID}" == "fedora" ] ; then

   packages=( containerd docker docker-buildx docker-cli docker-compose )
   dnf install --setopt=install_weak_deps=False -y "${packages[@]}"

   # Add user to "docker" group:
   usermod -a -G docker "${USER_NAME}"


# ------ OpenSUSE -----------------------------------------------------------
elif [[ "${ID}" =~ ^opensuse- ]] ; then

   packages=( docker docker-buildx docker-compose )
   zypper --non-interactive install \
      --force-resolution --allow-vendor-change --allow-name-change --replacefiles \
      --no-recommends -y "${packages[@]}"

   # Add user to "docker" group:
   usermod -a -G docker "${USER_NAME}"

   systemctl enable docker.service
   systemctl start  docker.service || true


# ------ Alpine -------------------------------------------------------------
elif [ "${ID}" == "alpine" ] ; then

   packages=( containerd docker docker-cli docker-cli-buildx docker-cli-compose )
   apk add "${packages[@]}"

   # Add user to "docker" group:
   addgroup "${USER_NAME}" docker

   rc-update add docker default
   rc-service docker start || true


# ------ FreeBSD ------------------------------------------------------------
elif [ "${ID}" == "freebsd" ] ; then

   # FreeBSD has support for Podman:
   # https://freebsdfoundation.org/blog/oci-containers-on-freebsd/

   pkg install -y podman-suite

   if [ ! -e /etc/pf.conf ] && [ -e /usr/local/etc/containers/pf.conf.sample ] ; then
      interface="$(route -n get default 2>/dev/null | awk '/interface:/ { print $2 }')"
      if [ -z "${interface}" ] ; then
         interface="$(ifconfig -l | cut -d' ' -f1)"
      fi
      sed -e "s/^v4egress_if[ \t]*=.*$/v4egress_if = ${interface}/" \
          -e "s/^v6egress_if[ \t]*=.*$/v6egress_if = ${interface}/" \
          </usr/local/etc/containers/pf.conf.sample \
          >/etc/pf.conf
   fi
   sysrc pf_enable="YES" || true
   service pf start || true
   sysrc linux_enable="YES" || true
   service linux start || true
   sysrc podman_enable="YES" || true
   service podman start || true

   # Tests:
   # sudo podman run -it --rm ghcr.io/freebsd/freebsd-runtime:14.3 freebsd-version
   # sudo podman run -it --rm --os=linux docker.io/ubuntu:latest cat /etc/os-release
   # sudo podman run -it --rm --os=linux docker.io/dreibh/basic-debian:13 bash --login


# ------ NetBSD, OpenBSD, and Solaris ---------------------------------------
elif [ "${ID}" == "netbsd" ] || [ "${ID}" == "openbsd" ] || [ "${ID}" == "sunos" ] ; then

   exit 0   # There is no Docker -> nothing to do!

# ------ Unknown ------------------------------------------------------------
else

   echo >&2 "ERROR: Unknown ID ${ID} in /etc/os-release. The installation script may need an update for supporting this system!"
   exit 1

fi


# ====== Configuration ======================================================
if [ -d "/etc/docker" ] && [ ! -e "/etc/docker/daemon.json" ] ; then
   # By default, Docker creates a network interface docker0 172.17.0.1/16.
   # Since all systems have the same network, it interferes with SCTP.
   # SCTP assumes that source and destination host are the same => ABORT
   # Solution: Creating a /26 network with random link-local IPv4 address.
   network="169.254.$(( 1 + (RANDOM % 253) )).$(( ((RANDOM % 4) << 6) + 1 ))/26"
   ( cat <<EOF
{
  "bip": "${network}",
  "ipv6": true
}
EOF
   ) | tee "/etc/docker/daemon.json"
   service docker restart || true
fi
if [ -e "/usr/local/etc/containers/containers.conf" ] ; then
   # By default, Podman creates a default network 10.88.0.0/16.
   # Unfortunately, link-local IPv4 addresses do not work here.
   # => Using 192.168.x.y instead:
   network="192.168.$(( 1 + (RANDOM % 253) )).$(( ((RANDOM % 4) << 6) + 1 ))/26"
   sed -e "s@^#default_subnet[ \t]*=[ \t]*\"10.88.0.0/16\"@default_subnet = \"${network}\"@" \
       </usr/local/etc/containers/containers.conf \
       >/usr/local/etc/containers/containers.conf.new
   mv /usr/local/etc/containers/containers.conf.new /usr/local/etc/containers/containers.conf
fi


# ====== Verify command availability ========================================

echo "Verifying command availability:"
errors=0
if [ "$(uname)" == "Linux" ] ; then
   # shellcheck disable=SC2043
   for command in docker ; do
      echo -n "${command}: "
      if command -v "${command}" >/dev/null 2>&1 ; then
         echo "OK"
      else
         echo "FAILED!"
         errors=$((errors+1))
      fi
   done
fi
if [ ${errors} -gt 0 ] ; then
   echo >&2 "ERROR: ${errors} packages are missing!"
   exit 1
fi
