# along with this program.  If not, see <http://www.gnu.org/licenses/>.
#
# Contact: thomas.dreibholz@gmail.com

# Bash options:
set -euo pipefail


# ###########################################################################
# The "Development" installation is based on the "Basic" installation.
#
# It must contain the following packages:
#
# * [BC](https://pubs.opengroup.org/onlinepubs/9699919799/utilities/bc.html) (arbitrary precision calculator language)
# * [Clang](https://clang.llvm.org/) (Clang C and C++ compilers)
# * [CMake](https://cmake.org/) (build tool)
# * [CreateRepo](https://www.percona.com/blog/how-to-create-your-own-repositories-for-packages/) (RPM repository build tool; on Fedora Linux systems only!)
# * [DejaVu Fonts](https://dejavu-fonts.github.io/) (DejaVu fonts)
# * [ExifTool](https://exiftool.org/) (EXIF metadata editing tool for images)
# * [Docker](https://www.docker.com/) (Docker container management; on Linux systems only!)
# * [GhostScript](https://www.ghostscript.com/) (PostScript interpreter and fonts)
# * [GNU Autotools (Autoconf/Automake/Libtool)](https://www.gnu.org/software/automake/manual/html_node/Autotools-Introduction.html) (basic build tools)
# * [GNU Bison](https://www.gnu.org/software/bison/) (parser generator)
# * [Flex](https://github.com/westes/flex) (lexical analyser generator)
# * [GNU GCC/G++, GNU Make, GNU Debugger](https://gcc.gnu.org/) (compilers, debugger and make tool)
# * [Git LFS](https://git-lfs.com/) (large file storage for Git)
# * [GraphicsMagick](http://www.graphicsmagick.org/) (image conversion)
# * [Mock](https://fedoraproject.org/wiki/Using_Mock_to_test_package_builds) (RPM build tool; on Fedora Linux systems only!)
# * [Noto Fonts](https://fonts.google.com/noto) (Noto fonts, complete UTF-8 character range)
# * [PkgConfig](https://www.freedesktop.org/wiki/Software/pkg-config/) (metainformation about installed libraries)
# * [Open Sans Fonts](https://fonts.google.com/specimen/Open+Sans) (Open Sans fonts)
# * [Python](https://www.python.org/) (Python 3 interpreter, tools and PIP package management)
# * [ShellCheck](https://www.shellcheck.net/) (checker tool for shell scripts)
# * [Tidy](https://www.html-tidy.org/) (HTML/XML syntax checker and reformatter)
# * [URW Base 35 Fonts](https://github.com/ArtifexSoftware/urw-base35-fonts) (URW Base 35 fonts)
# * [Valgrind](https://valgrind.org/) (debugging tool; if available for architecture)
# * [YamlLint](https://github.com/adrienverge/yamllint) (checker tool for YAML)
# * [Reprepro](https://wiki.debian.org/DebianRepository/SetupWithReprepro) (DEB repository build tool; on Debian/Ubuntu Linux systems only!)
# * [PBuilder](https://pbuilder-team.pages.debian.net/pbuilder/) (DEB build tool; on Debian/Ubuntu Linux systems only!)
#
# It must contain the following libraries and development files:
#
# * [BOOST C++ Libraries](https://www.boost.org/) (portable C++ libraries)
# * SCTP development files
#
# Further properties:
#
# * Password-less sudo calls. ⚠WARNING: Development settings are intended for developers only!
# * Wireshark as regular user is allowed. ⚠WARNING: Development settings are intended for developers only!
# * Source packages enabled from package manager (if available)
# ###########################################################################


# ###### Print script name, to make Packer output easier readable ###########
SCRIPT="30-development"   # Set to "$(basename "$0")" of this file!
if command -v figlet >/dev/null && command -v print-utf8 >/dev/null ; then
   echo
   LC_ALL=C.UTF-8 print-utf8 -x 160 -n -s "\e[1;31m█" "▀" "█\e[0m"
   figlet -w 156 "${SCRIPT}" | LC_ALL=C.UTF-8 print-utf8 -x 160 -n -C "\e[1;31m█\e[22m" "\e[1;31m█\e[0m"
   LC_ALL=C.UTF-8 print-utf8 -x 160 -n -s "\e[1;31m█" "▄" "█\e[0m"
else
   echo -e "\e[1;31;22m########## ${SCRIPT} ##########\e[0m"
fi

# Enable printing the command-lines executed:
set -x


# ###### Main program #######################################################

# ====== Check/set environment variables ====================================
if [ ! -v USER_NAME ] || [ "${USER_NAME}" == "" ] ; then
   echo >&2 "Usage: env USER_NAME=<user> $0"
   echo >&2 "Example: sudo env USER_NAME=nornetpp $0"
   exit 1
fi

# ====== Obtain system details ==============================================
UNAME="$(uname)"
NAME="${UNAME}"
ID="${UNAME,,}"
VERSION="$(uname -r)"
VERSION_ID="${VERSION/_*/}"
if [ -f /etc/os-release ] ; then
   . /etc/os-release
fi


# ====== Package installation ===============================================

# ------ Ubuntu/Debian ------------------------------------------------------
if [ "${ID}" == "ubuntu" ] || [ "${ID}" == "debian" ] ; then

   # Programs:
   packages=(
      autoconf
      automake
      bc
      bison
      build-essential
      clang
      cmake
      debhelper
      devscripts
      dpkg-dev
      distro-info
      flex
      fonts-dejavu
      fonts-noto
      fonts-open-sans
      g++
      gcc
      gdb
      ghostscript
      git-lfs
      graphicsmagick
      gsfonts
      libimage-exiftool-perl
      manpages-dev
      pbuilder
      pkg-config
      python3-distro
      python3-psutil
      python3-pip
      r-base
      reprepro
      shellcheck
      tidy
      fonts-urw-base35
   )

   # Development files:
   packages+=(
      libboost-all-dev
      libbz2-dev
      libc-ares-dev
      libcurl4-openssl-dev
      liblzma-dev
      libmaxminddb-dev
      libpqxx-dev
      libsctp-dev
      libssl-dev
      zlib1g-dev
   )

   if [ "${ID}" == "debian" ] && [[ "${VERSION_ID}" -le 11 ]] ; then
     # Debian 11: Qt 5
      packages+=( extra-cmake-modules libmongoc-dev python3-venv yamllint libtool-bin libmariadb-dev qtbase5-dev qtbase5-dev-tools qttools5-dev )
   elif [ "${ID}" == "ubuntu" ] && [[ "${VERSION_ID}" =~ ^1[2345]\.[01][04]$ ]] ; then
      # Ubuntu 12.04, 14.04:
      packages+=( libtool libmariadbclient-dev qtbase5-dev qtbase5-dev-tools qttools5-dev )
   elif [ "${ID}" == "ubuntu" ] && [[ "${VERSION_ID}" =~ ^1[67]\.[01][04]$ ]] ; then
      # Ubuntu 16.04:
      packages+=( extra-cmake-modules libmongoc-dev python3-venv yamllint libtool-bin libmariadb-client-lgpl-dev qtbase5-dev qtbase5-dev-tools qttools5-dev )
   elif [ "${ID}" == "ubuntu" ] && [[ "${VERSION_ID}" =~ ^1[89]\.[01][04]$ ]] ; then
     # Ubuntu 18.04: Qt 5
      packages+=( extra-cmake-modules libmongoc-dev python3-venv yamllint libtool-bin qtbase5-dev qtbase5-dev-tools qttools5-dev )
   elif [ "${ID}" == "ubuntu" ] && [[ "${VERSION_ID}" =~ ^2[01]\.[01][04]$ ]] ; then
     # Ubuntu 20.04: Qt 5
      packages+=( extra-cmake-modules libmongoc-dev python3-venv yamllint libtool-bin qtbase5-dev qtbase5-dev-tools qttools5-dev )
   else
      # Newer Ubuntu and Debian systems:
      packages+=( extra-cmake-modules libmongoc-dev python3-venv yamllint libtool-bin libmariadb-dev qt6-base-dev qt6-l10n-tools )
   fi

   env DEBIAN_FRONTEND=noninteractive apt-get install -y -m --no-install-recommends "${packages[@]}"
   # Install Valgrind, if available:
   env DEBIAN_FRONTEND=noninteractive apt-get install -y -m --no-install-recommends valgrind || true

# ------ Fedora -------------------------------------------------------------
elif [ "${ID}" == "fedora" ] ; then

   # Programs:
   packages=(
      autoconf
      automake
      bc
      bison
      clang
      cmake
      dejavu-fonts-all
      extra-cmake-modules
      flex
      g++
      gcc
      gdb
      ghostscript
      git-lfs
      google-noto-fonts-all
      GraphicsMagick
      libtool
      mock
      open-sans-fonts
      perl-Image-ExifTool
      pkg-config
      python3
      python3-distro
      python3-psutil
      python3-pip
      python3-setuptools
      R-base
      rpm-build
      shellcheck
      tidy
      urw-base35-fonts
      yamllint
   )

   # Development files:
   packages+=(
      boost-devel
      bzip2-devel
      c-ares-devel
      libbson-devel
      libcurl-devel
      libmaxminddb-devel
      libpqxx-devel
      lksctp-tools-devel
      mariadb-connector-c-devel
      mongo-c-driver-devel
      openssl-devel
      qt6-linguist
      qt6-qtbase-devel
      rsplib-libcpprspserver-devel
      rsplib-librsplib-devel
      xz-devel
      zlib-devel
   )

   dnf install --setopt=install_weak_deps=False -y "${packages[@]}"
   # Install Valgrind, if available:
   dnf install --setopt=install_weak_deps=False -y valgrind || true

   # Add user to "mock" group:
   usermod -a -G mock "${USER_NAME}"


# ------ OpenSUSE -----------------------------------------------------------
elif [[ "${ID}" =~ ^opensuse- ]] ; then

   packages=(
      autoconf
      automake
      bc
      bison
      clang
      cmake
      dejavu-fonts
      extra-cmake-modules
      exiftool
      flex
      gcc
      gcc-c++
      gdb
      ghostscript
      git-lfs
      google-opensans-fonts
      noto-sans-fonts
      GraphicsMagick
      libtool
      make
      pkgconfig
      python3
      python3-distro
      python3-psutil
      python3-pip
      python3-setuptools
      R-base
      rpm-build
      ShellCheck
      tidy
      urw-base35-fonts
      python3-yamllint
   )

   # Development files:
   packages+=(
      boost-devel
      bson-devel
      c-ares-devel
      libbz2-devel
      libcurl-devel
      libmaxminddb-devel
      libmariadb-devel
      libopenssl-devel
      libpqxx-devel
      lksctp-tools-devel
      mongo-c-driver-devel
      qt6-base-devel
      qt6-tools
      rsplib-libcpprspserver-devel
      rsplib-librsplib-devel
      xz-devel
      zlib-devel
   )
   zypper --non-interactive install \
      --force-resolution --allow-vendor-change --allow-name-change --replacefiles \
      --no-recommends -y "${packages[@]}"
   # Install Valgrind, if available:
   zypper --non-interactive install \
      --force-resolution --allow-vendor-change --allow-name-change --replacefiles \
      --no-recommends -y valgrind || true


# ------ Alpine -------------------------------------------------------------
elif [ "${ID}" == "alpine" ] ; then

   packages=(
      abuild
      autoconf
      automake
      bc
      bison
      build-base
      clang
      cmake
      exiftool
      extra-cmake-modules
      flex
      font-dejavu
      font-noto
      font-opensans
      font-urw-base35
      g++
      gcc
      gdb
      ghostscript
      git-lfs
      graphicsmagick
      libtool
      make
      pkgconf
      python3
      py3-distro
      py3-psutil
      py3-pip
      py3-setuptools
      R
      shellcheck
      tidyhtml
      yamllint
   )

   # Development files:
   packages+=(
      boost-dev
      bzip2-dev
      c-ares-dev
      curl-dev
      libmaxminddb-dev
      mariadb-dev
      mongo-c-driver-dev
      openssl-dev
      qt6-qtbase-dev
      qt6-qttools-dev
      xz-dev
      zlib-dev
   )

   apk add "${packages[@]}"
   # Install Valgrind, if available:
   apk add valgrind || true


# ------ FreeBSD ------------------------------------------------------------
elif [ "${ID}" == "freebsd" ] ; then

   # Programs:
   packages=(
      autoconf
      automake
      bison
      cmake
      dejavu
      flex
      gcc
      gdb
      ghostscript10
      git-lfs
      GraphicsMagick
      hs-ShellCheck
      libtool
      noto
      opensans-ttf
      p5-Image-ExifTool
      p5-PkgConfig-LibPkgConf
      pkgconf
      py312-distro
      py312-psutil
      py312-yamllint
      python
      R
      urw-base35-fonts
      tidy-html5
   )

   # Development files:
   packages+=(
      boost-all
      mongo-c-driver
      postgresql-libpqxx
      qt6-base
   )

   pkg install -y "${packages[@]}"
   # Install Valgrind, if available:
   pkg install -y valgrind || true

   # Fetch and check out the FreeBSD Sources:
   branch="main"
   if [[ "${VERSION}" =~ -RELEASE$ ]] ; then
      branch="releng/${VERSION_ID}"
      echo "Release branch: ${branch}"
   elif [[ "${VERSION}" =~ -STABLE$ ]] ; then
      branch="stable/${VERSION_ID//.[0-9]*/}"
      echo "Stable branch: ${branch}"
   fi
   if [ -d /usr/src/.git ] ; then
      cd /usr/src
      git fetch --all
      git checkout "${branch}"
      git pull
   else
      echo >&2 "ERROR: /usr/src is not initialised as a Git repository!"
      exit 1
   fi

   # Fetch and check out the FreeBSD Ports Collection:
   if [ -d /usr/ports/.git ] ; then
      cd /usr/ports
      git fetch --all
      git checkout main
      git pull
   else
      echo >&2 "ERROR: /usr/ports is not initialised as a Git repository!"
      exit 1
   fi


# ------ NetBSD -------------------------------------------------------------
elif [ "${ID}" == "netbsd" ] ; then

   # Programs:
   packages=(
      autoconf
      automake
      bison
      cmake
      dejavu-ttf
      flex
      gcc15
      gdb
      ghostscript-agpl
      git-lfs
      GraphicsMagick
      shellcheck
      libtool-base
      noto-fonts
      p5-Image-ExifTool
      p5-PkgConfig
      pkgconf
      py314-distro
      py314-psutil
      py314-yamllint
      python314
      R
      urw-fonts
      tidy
   )

   # Development files:
   packages+=(
      boost-headers
      boost-libs
      mongo-c-driver
      libpqxx
      qt6
   )

   pkgin -y install "${packages[@]}"

   # Fetch and check out the NetBSD Ports Collection:
   if [ -d "/usr/pkgsrc/.git" ] ; then
      cd /usr/pkgsrc
      git fetch --all
      git checkout trunk
      git pull
   else
      echo >&2 "ERROR: /usr/pkgsrc is not initialised as a Git repository!"
      exit 1
   fi
   if [ -d "/usr/pkgsrc/wip/.git" ] ; then
      cd /usr/pkgsrc
      git fetch --all
      git checkout master
      git pull
   else
      echo >&2 "ERROR: /usr/pkgsrc/wip is not initialised as a Git repository!"
      exit 1
   fi


# ------ OpenBSD ------------------------------------------------------------
elif [ "${ID}" == "openbsd" ] ; then

   # Programs:
   packages=(
      "$(pkg_info -Q autoconf | grep -E '^autoconf-[0-9]' | cut -d" " -f1 | sort -V | tail -n 1)"
      "$(pkg_info -Q automake | grep -E '^automake-[0-9]' | cut -d" " -f1 | sort -V | tail -n 1)"
      bison
      cmake
      g++
      gcc
      gdb
      ghostscript--
      git-lfs
      graphicsmagick
      libtool
      shellcheck
      noto-fonts
      roboto-fonts
      p5-Image-ExifTool
      py3-distro
      py3-psutil
      py3-yamllint
      "$(pkg_info -Q python | grep -E '^python-[0-9]' | cut -d" " -f1 | sort -V | tail -n 1)"
      R
      tidyp
   )

   # Development files:
   packages+=(
      boost
      # mongo-c-driver -> Not available in official ports (must build from source).
      libpqxx
      qt6
   )

   pkg_add -r -I "${packages[@]}"

   # Fetch and check out the OpenBSD Ports Collection:
   if [ -d /usr/ports/.git ] ; then
      cd /usr/ports
      git fetch --all
      git checkout master
      git pull
   else
      echo >&2 "ERROR: /usr/ports is not initialised as a Git repository!"
      exit 1
   fi


# ------ Solaris ------------------------------------------------------------
elif [ "${ID}" == "sunos" ] ; then

   # Programs:
   packages=(
      developer/build/autoconf
      developer/build/automake
      pkg://openindiana.org/developer/build/cmake
      developer/build/libtool
      developer/build/make
      developer/build/pkg-config
      developer/clang-18
      developer/gcc-14
      developer/debug/gdb
      developer/lexer/flex
      developer/parser/bison
      image/graphicsmagick
      library/security/openssl
      runtime/python-314
      text/tidy
      python/yamllint
   )

   # Development files:
   packages+=(
      database/mariadb-114/library
      developer/object-file
      library/boost
      library/zlib
      system/header
   )

   pkg install "${packages[@]}" || [ $? -eq 4 ]
   # Install Valgrind, if available:
   pkg install valgrind || true


# ------ Unknown ------------------------------------------------------------
else

   echo >&2 "ERROR: Unknown ID ${ID} in /etc/os-release. The installation script may need an update for supporting this system!"
   exit 1

fi


# ====== Verify command availability ========================================

# ------ Prepare list of required commands ----------------------------------
programs=(
   autoconf
   automake
   bc
   bison
   clang
   clang++
   cmake
   exiftool
   flex
   gdb
   gm
   gs
   libtool
   make
   pkg-config
)

if [ "${ID}" == "openbsd" ] ; then
   programs+=( eg++ egcc )
else
   programs+=( g++ gcc )
fi

if [ "${ID}" == "ubuntu" ] && [[ "${VERSION_ID}" =~ ^1[2345]\.[01][04]$ ]] ; then
   true
elif [ "${ID}" == "netbsd" ] ; then
   programs+=( yamllint-3.14 )
else
   programs+=( yamllint )
fi
if [ "${ID}" == "ubuntu" ] || [ "${ID}" == "debian" ] ; then
   programs+=( pbuilder reprepro )
elif [ "${ID}" == "fedora" ] ; then
   programs+=( createrepo mock )
elif [ "${ID}" == "alpine" ] ; then
   programs+=( abuild )
fi

if [ "${ID}" == "netbsd" ] || [ "${ID}" == "openbsd" ] ; then
   true   # No Valgrind in NetBSD and OpenBSD, yet.
else
   if [[ "$(uname -m)" =~ ^(amd64|x86_64|arm64|aarch64)$ ]] ; then
      # Valgrind is at least available for AMD64 and ARM64:
      programs+=( valgrind )
   fi
fi

if [  "${ID}" == "sunos" ] ; then
   true   # No git-lfs and Shell-Check in Solaris, yet.
else
   programs+=( git-lfs shellcheck )
fi

# ------ Verify command availability ----------------------------------------
set +x
echo "Verifying command availability:"
errors=0
missing=()
for command in "${programs[@]}" ; do
   if ! command -v "${command}" >/dev/null 2>&1 ; then
      errors=$((errors+1))
      missing+=( "${command}" )
   fi
done
if [ ${errors} -gt 0 ] ; then
   echo >&2 "ERROR: ${errors} commands are missing:"
   (
      for program in "${missing[@]}" ; do
         echo >&2 " * ${program}"
      done
   ) | sort
   exit 1
else
   echo "OK"
fi
set -x
