// Alpine 3.24

{
  "image":    "alpine:3.24",
  "platform": "{{user `vm_platform`}}",
  "pull":     "true",
  "commit":   "true",
  "changes": [
     "ENV LC_ALL C.UTF-8",
     "ENV LANG C.UTF-8",
     "CMD [ \"/bin/bash\", \"--login\" ]"
  ]
}
